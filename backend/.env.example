# =============================================================
#  CONFIGURACIÓN DE ENTORNO - Compra Venta e Inventario MVP
# =============================================================
# Copia este archivo como .env y completa los valores reales.

# --- Supabase PostgreSQL ---
# Obtenlo en: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:TU_PASSWORD_AQUI@db.TU_PROJECT_REF.supabase.co:5432/postgres

# --- JWT Security ---
# Genera uno seguro con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga_y_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (frontend URL en producción) ---
FRONTEND_URL=http://localhost:5173
